[Version]
Signature   = "$Windows NT$"
Class       = ActivityMonitor
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %Provider%
CatalogFile = stdio.cat
DriverVer   = 11/24/2026,0.1.0.0
PnpLockdown = 1

[DestinationDirs]
DriverFiles = 13

[DefaultInstall.NTamd64]
CopyFiles = DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = stdio,0x00000000,DriverService

[DriverService]
DisplayName    = %Provider%
Description    = %Description%
ServiceBinary  = %13%\stdio.sys
Dependencies   = FltMgr
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "FSFilter Activity Monitor"
AddReg         = Instances

[Instances]
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%Instance%
HKR,"Parameters\Instances\"%Instance%,"Altitude",0x00000000,%LabAltitude%
HKR,"Parameters\Instances\"%Instance%,"Flags",0x00010001,0x1

[DriverFiles]
stdio.sys

[SourceDisksFiles]
stdio.sys = 1

[SourceDisksNames]
1 = %Provider%

[Strings]
Provider    = "stdio.sys"
Description = "stdio.sys NTFS minifilter diagnostics"
Instance    = "stdio.sys lab instance"
LabAltitude = "385981.24001"
